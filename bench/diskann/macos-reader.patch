+/*
+ * Copyright (c) Microsoft Corporation.
+ * Licensed under the MIT license.
+ */
+
+//! macOS reader for benchmarking against the SSD: `F_NOCACHE` (the closest macOS analogue of
+//! `O_DIRECT`) and one `pread` per request. macOS has no io_uring, so a beam's reads are issued
+//! one after another; queue depth comes from running more search threads.
+
+use std::{
+    fs::File,
+    os::{fd::AsRawFd, unix::fs::FileExt},
+};
+
+use diskann::ANNResult;
+
+use crate::search::provider::aligned_file_reader::{traits::AlignedFileReader, AlignedRead, A512};
+
+pub struct MacAlignedFileReader {
+    file: File,
+}
+
+impl MacAlignedFileReader {
+    pub fn new(fname: &str) -> ANNResult<Self> {
+        let file = File::open(fname)?;
+        if unsafe { libc::fcntl(file.as_raw_fd(), libc::F_NOCACHE, 1) } == -1 {
+            return Err(std::io::Error::last_os_error().into());
+        }
+        Ok(Self { file })
+    }
+}
+
+impl AlignedFileReader for MacAlignedFileReader {
+    type Alignment = A512;
+
+    fn read(&mut self, read_requests: &mut [AlignedRead<u8, A512>]) -> ANNResult<()> {
+        for r in read_requests {
+            let offset = r.offset();
+            self.file.read_exact_at(r.aligned_buf_mut(), offset)?;
+        }
+        Ok(())
+    }
+}
